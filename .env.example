# Copy to .env and fill in. Never commit .env. Share real keys over a private channel.

# Shared
PUBLIC_BASE_URL=https://your-fixed-domain.example
DATABASE_URL=
HUDDLR_SECRET=                # shared secret sent as the x-huddlr-secret header between services and by the voice tools
DEMO_USER_PHONE=             # the one demo customer, E.164 (for example +12145550123)

# Finance (P1)
NESSIE_API_KEY=
NESSIE_BASE_URL=
DATA_SOURCE=persona        # persona | nessie
FINANCE_PORT=4000
FINANCE_MODE=engine          # engine (real forecast over the persona) | stub (fixtures only)
FINANCE_SCENARIO=normal      # stub only: normal | shortfall
AGENTS_URL=                  # where finance forwards proposal calls; defaults to http://localhost:5000

# Agents (P2)
GEMINI_API_KEY=
CHARACTER_MODEL=              # optional; default gemini-3.5-flash-lite (contracts/agents-config.json)
AGENTS_PORT=5000              # Caddy routes /agents/* here

# Photon (P3)
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_WEBHOOK_SECRET=

# Voice (P4)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=   # HMAC secret for the post-call webhook (ElevenLabs workspace webhooks)
VOICE_PORT=6000                # Caddy routes /voice/* here
FINANCE_URL=                 # optional; defaults to PUBLIC_BASE_URL
ELEVENLABS_PHONE_NUMBER_ID=  # the imported Photon number's id in ElevenLabs (needed for outbound calls)
VOICE_OPTED_IN_NUMBERS=      # comma-separated E.164 numbers that agreed to be called; defaults to DEMO_USER_PHONE
VOICE_OUTBOUND=on            # off stops the call_requests poller
VOICE_PHONE_NUMBER=          # the Photon SMS number in E.164, e.g. +18286472114 (setup:elevenlabs imports it)
ELEVENLABS_VOICE_ID=         # optional voice for the agent
ELEVENLABS_LLM=              # optional, default gemini-2.0-flash
