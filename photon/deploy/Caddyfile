# Each path goes to one teammate's service.
# photon (P3) 3000, finance (P1) 4000, agents (P2) 5000, voice (P4) 6000, dashboard (P3) 3001
__DOMAIN__ {
	handle /photon/* {
		reverse_proxy localhost:3000
	}
	handle /facts* {
		reverse_proxy localhost:4000
	}
	handle /tools/* {
		reverse_proxy localhost:4000
	}
	# finance: health (public), events (needs x-huddlr-secret).
	# /admin/* is deliberately NOT routed: the dashboard's demo controller calls it on localhost.
	handle /health {
		reverse_proxy localhost:4000
	}
	handle /events* {
		reverse_proxy localhost:4000
	}
	handle /admin/* {
		respond 404
	}
	handle /agents/* {
		reverse_proxy localhost:5000
	}
	handle /voice/* {
		reverse_proxy localhost:6000
	}
	handle {
		reverse_proxy localhost:3001
	}
}
